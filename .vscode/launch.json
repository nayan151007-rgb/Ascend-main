{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Ascend: FastAPI (Uvicorn)",
      "type": "debugpy",
      "request": "launch",
      "module": "uvicorn",
      "args": ["app.main:app", "--reload", "--host", "0.0.0.0", "--port", "8000"],
      "envFile": "${workspaceFolder}/.env",
      "jinja": true
    },
    {
      "name": "Ascend: Full-Stack Node/Express (Port 3000)",
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "npx",
      "runtimeArgs": ["tsx", "server.ts"],
      "envFile": "${workspaceFolder}/.env"
    }
  ]
}
